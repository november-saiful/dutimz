{
  "name": "dutimz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "prebuild": "node scripts/write-asset-version.mjs",
    "build": "astro build && node scripts/build-client.mjs",
    "test:ui": "PUBLIC_DEMO_MODE=true npm run build && node --test tests/*.test.mjs",
    "preview": "wrangler pages dev dist",
    "check:worker": "tsc --noEmit -p worker/tsconfig.json",
    "deploy:pages": "wrangler pages deploy dist --project-name=dutimz",
    "deploy": "npm run deploy:media && npm run deploy:pages",
    "deploy:media": "wrangler deploy --config worker/wrangler.jsonc",
    "test:db": "supabase test db",
    "test": "npm run check && npm run check:worker && npm run test:ui && npm run test:db"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@cloudflare/workers-types": "^5.20260911.1",
    "astro": "^7.3.3",
    "esbuild": "^0.25.10",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  }
}
