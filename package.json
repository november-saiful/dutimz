{
  "name": "dutimz",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev": "next dev",
    "check": "tsc --noEmit",
    "build": "next build",
    "test:ui": "NEXT_PUBLIC_DEMO_MODE=true npm run build && node --test tests/ui-smoke.test.mjs tests/overflow.test.mjs tests/media-worker-origin.test.mjs tests/pgtap-plan.test.mjs tests/release-pipeline.test.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "check:worker": "tsc --noEmit -p worker/tsconfig.json",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:portal": "npm run deploy",
    "deploy:media": "wrangler deploy --config worker/wrangler.jsonc",
    "test:db": "supabase test db",
    "test": "npm run check && npm run check:worker && npm run test:ui && npm run test:db"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.57.4",
    "@tabler/icons-react": "^3.48.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^13.4.6",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@opennextjs/cloudflare": "^1.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  }
}
