{
  "name": "dutimz",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev": "next dev",
    "check": "tsc --noEmit",
    "build": "next build",
    "test:ui": "NEXT_PUBLIC_DEMO_MODE=true npm run build && node --test tests/*.test.mjs",
    "preview": "wrangler pages dev .open-next --project-name=dutimz",
    "check:worker": "tsc --noEmit -p worker/tsconfig.json",
    "deploy:pages": "npx @opennextjs/cloudflare build && wrangler pages deploy .open-next --project-name=dutimz",
    "deploy": "npm run deploy:media && npm run deploy:pages",
    "deploy:media": "wrangler deploy --config worker/wrangler.jsonc",
    "test:db": "supabase test db",
    "test": "npm run check && npm run check:worker && npm run test:ui && npm run test:db"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.57.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@opennextjs/cloudflare": "^1.3.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  }
}
