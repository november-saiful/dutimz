{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dutimz-media",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "dutimz-media"
    },
    {
      "binding": "SPOTLIGHT_BUCKET",
      "bucket_name": "dutimz-spotlight"
    }
  ],
  "images": { "binding": "IMAGES" },
  // Every five minutes this Worker asks the portal to rewrite the pages every reader sees, and
  // every hour it asks it to settle view earnings into the ledger. The portal cannot schedule
  // either itself: its generated entry exports only `fetch`. CACHE_REFRESH_TOKEN and
  // VIEWS_SETTLE_TOKEN are secrets (set by the release), never vars — anyone who holds them can
  // force the site to render or credit money, the two things this cache and this ledger exist to
  // keep under the desk's control.
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://dutimz.com,https://www.dutimz.com",
    "CACHE_REFRESH_URL": "https://dutimz.com/api/cache/refresh",
    "VIEWS_SETTLE_URL": "https://dutimz.com/api/views/settle"
  }
}
