{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "dutimz",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dutimz"
    }
  ],
  // Caching. Routes that export `revalidate` are served from the bucket below and regenerated
  // by the queue in open-next.config.ts; without either the adapter falls back to its dummy
  // implementations, every public page re-renders on every request, and the site returns
  // `x-nextjs-cache: MISS` forever (which is exactly what the live site did).
  //
  // This bucket holds rendered pages and data-cache entries only — never media — so the media
  // buckets stay bound to the media Worker alone. `observability` is what makes the Worker's
  // own logs (including every reportError) queryable instead of write-only.
  //
  // Bindings are *not* inherited by environments, so `env.preview` re-declares each one.
  "observability": { "enabled": true },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "dutimz-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      // Only the tag cache is bound. Revalidation used to have a second Durable Object here
      // (`NEXT_CACHE_DO_QUEUE` -> `DOQueueHandler`), and it is deliberately gone:
      //
      //   - it is billed for every second it is awake at 128 MB, and the Workers Free allowance
      //     is 13,000 GB-s a day — 28.2 hours of one object. A 60-second window on nine routes
      //     keeps that object awake more or less permanently, which is what exhausted the daily
      //     quota and blocked every Durable Object request until the UTC reset;
      //   - it remembers a failed revalidation in its own SQLite, keyed by a hash that is
      //     constant for an unchanged entry, and only clears it when the build id changes. One
      //     transient failure therefore froze that route at `x-nextjs-cache: STALE` until the
      //     next deploy, while still waking the object on every reader's request.
      //
      // open-next.config.ts hands the same HEAD request to `ctx.waitUntil` instead: no idle cost,
      // no state that outlives the attempt, and a failure is retried by the next stale request.
      // The `v1` migration below stays because migrations are append-only and the class is still
      // exported by the generated Worker, so removing the tag would fail the deploy.
      // The tag cache is what makes `revalidatePath` mean anything: the desk's approvals and
      // edits invalidate the cached reading surfaces through it. The class is exported by the
      // generated Worker even if this binding is absent, so a missing binding here degrades
      // silently — pages simply wait out their revalidate window instead.
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  // Migrations are append-only: a class that is already deployed has to keep the tag it was
  // created with, so the tag cache gets a tag of its own rather than being folded into v1.
  // `v1` stays even though `DOQueueHandler` is no longer bound — the class is still exported by
  // the generated Worker, and dropping a tag that has already been applied is not a redeploy.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DOShardedTagCache"]
    }
  ],
  // The public hostnames are declared here instead of being clicked into the dashboard, so
  // every release re-asserts the binding rather than silently leaving them on a retired
  // Pages project. A Custom Domain matches one exact hostname, so the apex and www are both
  // listed; middleware.ts redirects www to the apex once the Worker receives those requests.
  //
  // They can only be attached while no other Cloudflare project owns the hostnames: remove
  // dutimz.com and www.dutimz.com from the old Pages project first, or `wrangler deploy`
  // fails because the hostname is already in use.
  "routes": [
    {
      "pattern": "dutimz.com",
      "custom_domain": true
    },
    {
      "pattern": "www.dutimz.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_DEMO_MODE": "false",
    "NEXT_PUBLIC_SITE_URL": "https://dutimz.com",
    "NEXT_PUBLIC_MEDIA_URL": "https://media.dutimz.com"
  },
  "env": {
    "preview": {
      // A pull-request preview must never claim the production hostnames, so these routes are
      // cleared explicitly for this environment instead of being inherited.
      "routes": [
        {
          "pattern": "paper.dutimz.com",
          "custom_domain": true
        }
      ],
      // Bindings are non-inheritable, so the cache is declared again here rather than
      // inherited. A preview renders demo content, so it writes to its own bucket: the cache
      // key already includes the build id, but separate buckets keep preview churn from ever
      // growing the namespace a real reader is served from.
      "observability": { "enabled": true },
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "dutimz-cache-preview"
        }
      ],
      "durable_objects": {
        "bindings": [
          // No queue binding: revalidation runs in `ctx.waitUntil` inside the Worker itself, so
          // the preview needs no Durable Object for it either. The tag cache still has to be
          // declared here — bindings are not inherited — or the preview's `revalidatePath` is
          // accepted and does nothing.
          {
            "name": "NEXT_TAG_CACHE_DO_SHARDED",
            "class_name": "DOShardedTagCache"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["DOQueueHandler"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["DOShardedTagCache"]
        }
      ],
      // The queue regenerates a stale page by calling the Worker back through this binding,
      // and it has to name the preview script: `deploy --env preview` publishes
      // `<name>-<env>`, so the self reference is dutimz-preview, not dutimz.
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "dutimz-preview"
        }
      ],
      "vars": {
        "NEXT_PUBLIC_DEMO_MODE": "false",
        "NEXT_PUBLIC_SITE_URL": "https://paper.dutimz.com",
        "NEXT_PUBLIC_MEDIA_URL": "https://media.dutimz.com"
      }
    }
  }
}
