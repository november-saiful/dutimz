[TEMPLATE]
[TEMPLATE]
# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (Phase 2)
# In the Supabase dashboard: Authentication > Providers > Google —
# enable it, paste the Google OAuth client id/secret, and add
#   https://<project-ref>.supabase.co/auth/v1/callback
# as the authorized redirect URI in Google Cloud Console.
# Phase 2 is Google-only; email/magic-link providers stay disabled.

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_PAGES_PROJECT=dutimz-news

# Cloudflare R2 (image storage)
# Option 1: Set CLOUDFLARE_WORKER_URL to proxy uploads through the edge worker
CLOUDFLARE_WORKER_URL=https://dutimz-api.your-subdomain.workers.dev
# Option 2: Direct R2 uploads from the edge runtime
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=dutimz-images

# Optional: External services
WHATSAPP_API_KEY=
SENDGRID_API_KEY=
TTS_API_KEY=
