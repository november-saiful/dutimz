---
import { renderConnectedCarousel, type CarouselItem } from '../../lib/connected-carousel';

type Props = {
  items: CarouselItem[];
  label?: string;
  interval?: number;
};

const { items, label = 'সাম্প্রতিক প্রতিবেদন', interval = 6000 } = Astro.props;
---
<Fragment set:html={renderConnectedCarousel(items, label, interval)} />
