<BaseLayout title="ক্যাম্পাসের কার্যক্রমের পরিসংখ্যান" description="প্রকাশিত প্রতিবেদনের তথ্য থেকে তৈরি অপরাধ ও ক্যাম্পাস কার্যক্রমের পরিচয়বিহীন সামগ্রিক পরিসংখ্যান।" canonicalPath="/statistics/">
  <section class="account-page-shell dashboard-shell">
    <a class="back-link" href="/">← মূলপাতায় ফিরুন</a>
    <div class="account-page-heading"><span class="section-kicker">তথ্যভিত্তিক ক্যাম্পাস</span><h1>কার্যক্রমের পরিসংখ্যান</h1><p>প্রকাশিত প্রতিবেদনে দেওয়া শ্রেণিভিত্তিক তথ্যের সামগ্রিক চিত্র। এই পাতায় কোনো ব্যক্তি বা পরিচয়-সংক্রান্ত তথ্য প্রকাশ করা হয় না।</p></div>
    <div class="statistics-grid" data-public-questionnaire-stats><div class="feed-empty"><strong>পরিসংখ্যান লোড হচ্ছে…</strong></div></div>
    <p class="privacy-note">পরিসংখ্যানে শুধু প্রকাশিত প্রতিবেদনের সমষ্টিগত সংখ্যা দেখানো হয়। ভুক্তভোগী, অভিযুক্ত বা অন্য ব্যক্তির নাম ও পরিচয় এখানে দেখানো হয় না।</p>
  </section>
</BaseLayout>
