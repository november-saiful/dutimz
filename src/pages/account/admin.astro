---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="প্রশাসনিক নিয়ন্ত্রণ" description="DUTIMZ ব্যবহারকারী, মডারেশন ও উত্তোলন ব্যবস্থাপনা।" canonicalPath="/account/admin/">
  <section class="account-page-shell dashboard-shell">
    <a class="back-link" href="/account/">← অ্যাকাউন্টে ফিরুন</a>
    <div class="account-page-heading">
      <span class="section-kicker">নিরাপদ প্রশাসনিক নিয়ন্ত্রণ</span>
      <h1>প্রশাসন</h1>
      <p>ব্যবহারকারী, সম্পাদকীয় কাজ, অর্থ ও জবাবদিহি আলাদা বিভাগে পরিচালনা করুন। সংবেদনশীল প্রতিটি পরিবর্তনের কারণ নথিভুক্ত হবে।</p>
    </div>
    <div class="feed-empty admin-access-message" data-admin-access-message role="status">
      <strong>প্রশাসনিক অনুমতি যাচাই করা হচ্ছে…</strong>
    </div>
    <div class="admin-dashboard" data-admin-dashboard hidden>
      <div class="admin-dashboard__toolbar">
        <span class="section-kicker">প্রশাসনিক কর্মক্ষেত্র</span>
        <button class="outline-button" type="button" data-admin-refresh>↻ তথ্য রিফ্রেশ</button>
      </div>
      <nav class="admin-tabs" role="tablist" aria-label="প্রশাসনিক বিভাগ">
        <button class="admin-tab" id="admin-tab-overview" type="button" role="tab" aria-selected="true" aria-controls="admin-panel-overview" tabindex="0" data-admin-tab="overview">সারসংক্ষেপ</button>
        <button class="admin-tab" id="admin-tab-people" type="button" role="tab" aria-selected="false" aria-controls="admin-panel-people" tabindex="-1" data-admin-tab="people">ব্যবহারকারী ও দল</button>
        <button class="admin-tab" id="admin-tab-content" type="button" role="tab" aria-selected="false" aria-controls="admin-panel-content" tabindex="-1" data-admin-tab="content">প্রতিবেদন ও ফর্ম</button>
        <button class="admin-tab" id="admin-tab-questionnaire" type="button" role="tab" aria-selected="false" aria-controls="admin-panel-questionnaire" tabindex="-1" data-admin-tab="questionnaire">প্রশ্নমালা</button>
        <button class="admin-tab" id="admin-tab-finance" type="button" role="tab" aria-selected="false" aria-controls="admin-panel-finance" tabindex="-1" data-admin-tab="finance">অর্থ ও উত্তোলন</button>
        <button class="admin-tab" id="admin-tab-community" type="button" role="tab" aria-selected="false" aria-controls="admin-panel-community" tabindex="-1" data-admin-tab="community">মন্তব্য</button>
        <button class="admin-tab" id="admin-tab-audit" type="button" role="tab" aria-selected="false" aria-controls="admin-panel-audit" tabindex="-1" data-admin-tab="audit">নিরীক্ষা ও ইতিহাস</button>
      </nav>

      <section class="admin-tab-panel" id="admin-panel-overview" role="tabpanel" aria-labelledby="admin-tab-overview" tabindex="0" data-admin-panel="overview">
        <div class="admin-overview-card">
          <span class="section-kicker">কাজের জায়গা</span>
          <h2>প্রশাসনিক কাজ বেছে নিন</h2>
          <p>নির্দিষ্ট কাজের তালিকা ও ব্যবস্থাপনা টুল খুলতে নিচের শর্টকাট ব্যবহার করুন।</p>
          <div class="admin-shortcuts">
            <button type="button" data-admin-jump="people"><span aria-hidden="true">♙</span><strong>অ্যাকাউন্ট ও ভূমিকা</strong><span>সদস্য খুঁজুন, ভূমিকা নির্ধারণ করুন</span></button>
            <button type="button" data-admin-jump="content"><span aria-hidden="true">▤</span><strong>প্রকাশিত প্রতিবেদন</strong><span>প্রতিবেদন খুঁজুন ও সম্পাদনা করুন</span></button>
            <button type="button" data-admin-jump="questionnaire"><span aria-hidden="true">▦</span><strong>প্রশ্নমালা ও ফর্ম</strong><span>প্রশ্ন, শর্ত ও উত্তর-কাঠামো সম্পাদনা করুন</span></button>
            <button type="button" data-admin-jump="finance"><span aria-hidden="true">৳</span><strong>অর্থ ও উত্তোলন</strong><span>পেমেন্ট ও হিসাব সমন্বয়</span></button>
            <button type="button" data-admin-jump="community"><span aria-hidden="true">☷</span><strong>মন্তব্য পর্যালোচনা</strong><span>লুকান, অপসারণ বা পুনরুদ্ধার</span></button>
            <button type="button" data-admin-jump="audit"><span aria-hidden="true">◷</span><strong>নিরীক্ষা ইতিহাস</strong><span>কার্যক্রম ও ভূমিকা পরিবর্তন দেখুন</span></button>
          </div>
        </div>
      </section>

      <section class="admin-tab-panel" id="admin-panel-people" role="tabpanel" aria-labelledby="admin-tab-people" tabindex="0" data-admin-panel="people" hidden>
        <section class="admin-panel admin-user-lookup">
          <span class="section-kicker">অ্যাকাউন্ট খুঁজুন</span><h2>নাম বা ইউজারনেম দিয়ে সদস্য খুঁজুন</h2>
          <form class="admin-search-form" data-admin-user-search>
            <label class="field-label" for="admin-user-query">সদস্যের নাম / ইউজারনেম<input id="admin-user-query" name="query" type="search" maxlength="80" placeholder="যেমন: পাঠক বা reader_…" /></label>
            <button class="outline-button" type="submit">সদস্য খুঁজুন</button>
          </form>
          <p class="member-directory__status" data-admin-user-count aria-live="polite"></p>
          <p class="form-error" role="alert" data-admin-user-search-error hidden></p>
          <button class="text-link-button" type="button" data-admin-user-clear>সব সদস্য</button>
          <div class="admin-search-results" data-admin-user-results aria-live="polite"><div class="feed-empty"><strong>সদস্য তালিকা লোড হচ্ছে…</strong></div></div>
          <nav class="member-directory__pagination" aria-label="সদস্য তালিকার পৃষ্ঠা"><button class="outline-button" type="button" data-admin-user-prev disabled>আগের পৃষ্ঠা</button><span data-admin-user-page aria-live="polite"></span><button class="outline-button" type="button" data-admin-user-next disabled>পরের পৃষ্ঠা</button></nav>
        </section>
        <section class="admin-panel admin-member-editor" data-member-editor-panel hidden>
          <span class="section-kicker">তথ্য সম্পাদনা</span><h2 data-member-editor-title>সদস্য নির্বাচন করুন</h2>
          <p class="admin-selection" data-member-editor-selection>তালিকা থেকে একজন সদস্য বেছে নিলে তাঁর তথ্য এখানে খুলবে।</p>
          <form class="member-editor" data-member-editor>
            <input type="hidden" name="user_id" />
            <div class="editor-two-col"><label class="field-label">প্রদর্শিত নাম<input name="display_name" maxlength="80" /></label><label class="field-label">ইউজারনেম<input name="username" required minlength="3" maxlength="24" pattern="[a-zA-Z][a-zA-Z0-9_]{2,23}" /></label></div>
            <label class="field-label">পরিচিতি (সর্বোচ্চ ২৮০ অক্ষর)<textarea name="bio" rows="3" maxlength="280"></textarea></label>
            <label class="field-label">প্রোফাইল ছবির লিংক<input name="avatar_url" maxlength="2048" placeholder="https://…" /></label>
            <div class="editor-two-col"><label class="field-label">ভূমিকা<select name="role"><option value="reader">রিডার</option><option value="reporter">রিপোর্টার</option><option value="moderator">মডারেটর</option><option value="admin">অ্যাডমিন</option></select></label><label class="field-label">রিপোর্টার স্তর<select name="reporter_tier"><option value="">প্রযোজ্য নয়</option><option value="junior">জুনিয়র — ৳৯০</option><option value="general">জেনারেল — ৳১১৫</option><option value="executive">এক্সিকিউটিভ — ৳১৪০</option></select></label></div>
            <div class="editor-two-col"><label class="field-label">বিভাগ<input name="department" maxlength="100" /></label><label class="field-label">বর্ষ / সেশন<input name="session" maxlength="24" /></label></div>
            <div class="editor-two-col"><label class="field-label">বিশ্ববিদ্যালয় নিবন্ধন নম্বর<input name="du_registration_number" maxlength="40" /></label><label class="field-label">আবাসিক অবস্থা<select name="residency_status"><option value="">অনির্ধারিত</option><option value="hall_resident">হল-আবাসিক</option><option value="off_campus">হলের বাইরে</option></select></label></div>
            <div class="editor-two-col"><label class="field-label">হলের নাম<input name="hall_name" maxlength="120" /></label><label class="field-label">হোয়াটসঅ্যাপ নম্বর<input name="whatsapp_number" maxlength="24" /></label></div>
            <label class="field-check"><input type="checkbox" name="whatsapp_na" /> হোয়াটসঅ্যাপ নম্বর দিতে চান না</label>
            <div class="editor-two-col"><label class="field-label">পেমেন্ট পদ্ধতি<select name="payout_method"><option value="">নির্ধারিত নয়</option><option value="bkash">বিকাশ</option><option value="nagad">নগদ</option></select></label><label class="field-label">পেমেন্ট নম্বর<input name="payout_number" maxlength="24" /></label></div>
            <label class="field-label">পরিবর্তনের কারণ<textarea name="reason" rows="3" minlength="3" maxlength="500" required></textarea></label>
            <p class="form-error" role="alert" data-member-editor-error hidden></p>
            <button class="read-button" type="submit"><span>সদস্যের তথ্য সংরক্ষণ করুন</span><span>→</span></button>
          </form>
        </section>
        <section class="admin-panel">
          <span class="section-kicker">ব্যবহারকারীর ভূমিকা</span><h2>ভূমিকা পরিবর্তন করুন</h2>
          <p class="admin-selection" data-admin-role-selection>সদস্য নির্বাচন করলে তার অ্যাকাউন্ট এখানে যুক্ত হবে। চাইলে UUID সরাসরি লিখতে পারেন।</p>
          <form class="admin-role-form" data-admin-role-form>
            <label class="field-label">ব্যবহারকারীর অ্যাকাউন্ট আইডি<input name="user_id" placeholder="সদস্য খুঁজে নির্বাচন করুন বা Supabase user UUID লিখুন" required /></label>
            <div class="editor-two-col"><label class="field-label">ভূমিকা<select name="role" required><option value="reader">রিডার</option><option value="reporter">রিপোর্টার</option><option value="moderator">মডারেটর</option><option value="admin">অ্যাডমিন</option></select></label><label class="field-label">রিপোর্টার স্তর<select name="reporter_tier"><option value="">প্রযোজ্য নয়</option><option value="junior">জুনিয়র — ৳৯০</option><option value="general">জেনারেল — ৳১১৫</option><option value="executive">এক্সিকিউটিভ — ৳১৪০</option></select></label></div>
            <label class="field-label">পরিবর্তনের কারণ<textarea name="reason" rows="3" maxlength="500" minlength="3" required></textarea></label>
            <p class="form-error" role="alert" data-admin-role-error hidden></p>
            <button class="read-button" type="submit"><span>ভূমিকা সংরক্ষণ করুন</span><span>→</span></button>
          </form>
        </section>
        <section class="admin-panel admin-applications-panel"><span class="section-kicker">সম্পাদকীয় দল</span><h2>রিপোর্টার আবেদন</h2><div data-admin-applications><div class="feed-empty"><strong>আবেদন লোড হচ্ছে…</strong></div></div></section>
      </section>

      <section class="admin-tab-panel" id="admin-panel-content" role="tabpanel" aria-labelledby="admin-tab-content" tabindex="0" data-admin-panel="content" hidden>
        <section class="admin-panel admin-pending-panel"><span class="section-kicker">সম্পাদকীয় পর্যালোচনা</span><h2>অপেক্ষমাণ প্রতিবেদন</h2><p>সম্পাদনা, অনুমোদন বা প্রত্যাখ্যানের সিদ্ধান্ত কারণসহ নথিভুক্ত করুন।</p><div class="moderation-queue" data-moderation-queue><div class="feed-empty"><strong>অপেক্ষমাণ প্রতিবেদন লোড হচ্ছে…</strong></div></div></section>
        <section class="admin-panel admin-articles-panel"><span class="section-kicker">প্রকাশিত আর্কাইভ</span><h2>প্রতিবেদন খুঁজুন ও সম্পাদনা করুন</h2>
          <form class="admin-search-form" data-admin-article-search><label class="field-label" for="admin-article-query">শিরোনাম দিয়ে খুঁজুন<input id="admin-article-query" name="query" type="search" maxlength="120" placeholder="প্রতিবেদনের শিরোনাম" /></label><button class="outline-button" type="submit">খুঁজুন</button><button class="text-link-button" type="button" data-admin-article-clear>সাম্প্রতিক প্রতিবেদন</button></form>
          <div class="moderation-history" data-admin-articles aria-live="polite"><div class="feed-empty"><strong>প্রতিবেদন লোড হচ্ছে…</strong></div></div>
        </section>
      </section>

      <section class="admin-tab-panel" id="admin-panel-questionnaire" role="tabpanel" aria-labelledby="admin-tab-questionnaire" tabindex="0" data-admin-panel="questionnaire" hidden>
        <section class="admin-panel questionnaire-admin-panel" data-admin-only hidden><span class="section-kicker">প্রশ্নমালার দৃশ্যমান সম্পাদক</span><h2>প্রতিবেদন ফর্মের প্রশ্ন ও শর্ত</h2><p>প্রশ্ন, বিকল্প, উত্তর-নির্ভর শর্ত এবং পুনরাবৃত্ত ব্যক্তিতথ্যের ঘর সম্পাদনা করুন। সংরক্ষণ করলে নতুন সংস্করণ তৈরি হবে; আগের প্রতিবেদনের উত্তর অপরিবর্তিত থাকবে।</p><div class="questionnaire-builder" data-questionnaire-editor></div><p class="form-error" role="alert" data-questionnaire-error hidden></p><p class="field-label">শর্তে ব্যবহারের উত্তরগুলো কমা (,) দিয়ে আলাদা করুন।</p><button class="outline-button" type="button" data-questionnaire-add>＋ নতুন প্রশ্ন</button> <button class="read-button" type="button" data-questionnaire-save><span>নতুন সংস্করণ সংরক্ষণ করুন</span><span>→</span></button><div class="moderation-history" data-questionnaire-responses></div></section>
      </section>

      <section class="admin-tab-panel" id="admin-panel-finance" role="tabpanel" aria-labelledby="admin-tab-finance" tabindex="0" data-admin-panel="finance" hidden>
        <section class="admin-panel admin-finance-panel"><span class="section-kicker">ম্যানুয়াল পেমেন্ট</span><h2>অপেক্ষমাণ উত্তোলন</h2><div data-admin-withdrawals><div class="feed-empty"><strong>অনুরোধ লোড হচ্ছে…</strong></div></div></section>
        <section class="admin-panel admin-balance-panel"><span class="section-kicker">হিসাব সমন্বয়</span><h2>সদস্যের হিসাব সমন্বয়</h2><p>সঠিক সদস্যের অ্যাকাউন্টে যোগ বা ফেরত সমন্বয় করুন। প্রতিটি সমন্বয়ের কারণ সংরক্ষিত হবে।</p>
          <form class="admin-balance-form" data-admin-balance-form><label class="field-label">ব্যবহারকারীর অ্যাকাউন্ট আইডি<input name="user_id" placeholder="Supabase user UUID" required /></label><label class="field-label">সমন্বয়ের পরিমাণ (৳)<input name="amount_tk" type="number" step="1" min="-10000000" max="10000000" placeholder="যোগের জন্য ধনাত্মক, ফেরতের জন্য ঋণাত্মক" required /></label><label class="field-label">সমন্বয়ের কারণ<textarea name="reason" rows="3" minlength="3" maxlength="500" required></textarea></label><p class="form-error" role="alert" data-admin-balance-error hidden></p><button class="read-button" type="submit"><span>হিসাব সমন্বয় সংরক্ষণ করুন</span><span>→</span></button></form>
        </section>
      </section>

      <section class="admin-tab-panel" id="admin-panel-community" role="tabpanel" aria-labelledby="admin-tab-community" tabindex="0" data-admin-panel="community" hidden>
        <section class="admin-panel admin-comments-panel"><span class="section-kicker">আলোচনার নিরাপত্তা</span><h2>সাম্প্রতিক মন্তব্য</h2><p>দৃশ্যমান মন্তব্য লুকান বা অপসারণ করুন; লুকানো মন্তব্য প্রয়োজন হলে পুনরুদ্ধার করা যাবে। সব সিদ্ধান্তের কারণ সংরক্ষিত হয়।</p><label class="field-label admin-comment-filter">অবস্থা<select data-admin-comment-filter><option value="all">সব মন্তব্য</option><option value="visible">শুধু দৃশ্যমান</option><option value="hidden">শুধু লুকানো</option></select></label><div data-admin-comments><div class="feed-empty"><strong>মন্তব্য লোড হচ্ছে…</strong></div></div></section>
      </section>

      <section class="admin-tab-panel" id="admin-panel-audit" role="tabpanel" aria-labelledby="admin-tab-audit" tabindex="0" data-admin-panel="audit" hidden>
