---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="প্রশাসনিক নিয়ন্ত্রণ" description="ডুটিমজ ব্যবহারকারী, মডারেশন ও উত্তোলন ব্যবস্থাপনা।" canonicalPath="/account/admin/">
  <section class="account-page-shell dashboard-shell"><a class="back-link" href="/account/">← অ্যাকাউন্টে ফিরুন</a><div class="account-page-heading"><span class="section-kicker">নিরাপদ প্রশাসনিক নিয়ন্ত্রণ</span><h1>প্রশাসন</h1><p>প্রতিটি পদোন্নতি, প্রত্যাখ্যান, পেমেন্ট বা পরিবর্তনের কারণ লিখুন। প্রশাসনিক কাজ ইতিহাসে সংরক্ষিত হবে।</p></div>
    <section class="admin-panel"><span class="section-kicker">ব্যবহারকারীর ভূমিকা</span><h2>ভূমিকা পরিবর্তন করুন</h2><form class="admin-role-form" data-admin-role-form><label class="field-label">ব্যবহারকারীর অ্যাকাউন্ট আইডি<input name="user_id" placeholder="Supabase user UUID" required /></label><div class="editor-two-col"><label class="field-label">ভূমিকা<select name="role" required><option value="reader">রিডার</option><option value="reporter">রিপোর্টার</option><option value="moderator">মডারেটর</option><option value="admin">অ্যাডমিন</option></select></label><label class="field-label">রিপোর্টার স্তর<select name="reporter_tier"><option value="">প্রযোজ্য নয়</option><option value="junior">জুনিয়র — ৳৯০</option><option value="general">জেনারেল — ৳১১৫</option><option value="executive">এক্সিকিউটিভ — ৳১৪০</option></select></label></div><label class="field-label">পরিবর্তনের কারণ<textarea name="reason" rows="3" maxlength="500" required></textarea></label><p class="form-error" role="alert" data-admin-role-error hidden></p><button class="read-button" type="submit"><span>ভূমিকা সংরক্ষণ করুন</span><span>→</span></button></form></section>
    <section class="admin-panel admin-finance-panel"><span class="section-kicker">ম্যানুয়াল পেমেন্ট</span><h2>অপেক্ষমাণ উত্তোলন</h2><div data-admin-withdrawals><div class="feed-empty"><strong>অনুরোধ লোড হচ্ছে…</strong></div></div></section>
    <section class="admin-panel admin-applications-panel"><span class="section-kicker">সম্পাদকীয় দল</span><h2>রিপোর্টার আবেদন</h2><div data-admin-applications><div class="feed-empty"><strong>আবেদন লোড হচ্ছে…</strong></div></div></section>
    <section class="admin-panel admin-comments-panel"><span class="section-kicker">আলোচনার নিরাপত্তা</span><h2>সাম্প্রতিক মন্তব্য</h2><div data-admin-comments><div class="feed-empty"><strong>মন্তব্য লোড হচ্ছে…</strong></div></div></section>
    <section class="ledger-section"><div class="feed-heading"><div><span class="section-kicker">পর্যালোচনার রেকর্ড</span><h2>মডারেশন ইতিহাস</h2></div></div><div class="moderation-history" data-moderation-history></div></section>
  </section>
</BaseLayout>
