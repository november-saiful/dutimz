---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../data/stories';
---
<BaseLayout title="প্রতিবেদন লিখুন" description="DUTIMZ-এ প্রতিবেদন পাঠান অথবা রিপোর্টার হিসেবে আবেদন করুন।" canonicalPath="/account/write/">
  <section class="account-page-shell writer-shell">
    <a class="back-link" href="/account/">← অ্যাকাউন্টে ফিরুন</a>
    <div class="account-page-heading"><span class="section-kicker">ক্যাম্পাসের কণ্ঠ হয়ে উঠুন</span><h1>প্রতিবেদন লিখুন</h1><p>সঠিক তথ্য, নিরপেক্ষ ভাষা ও প্রকাশের দায়িত্ববোধ নিয়ে আপনার গল্পটি পাঠান।</p></div>
    <section class="writer-gate" data-signed-out-only hidden>
      <span class="section-kicker">লেখা পাঠাতে প্রবেশ করুন</span>
      <h2>প্রতিবেদন পাঠাতে আগে অ্যাকাউন্টে প্রবেশ করুন</h2>
      <p>প্রতিবেদন আপনার অ্যাকাউন্টের সঙ্গেই যুক্ত থাকে—প্রকাশকের পরিচয়, পারিশ্রমিক ও সম্পাদকীয় যোগাযোগ সবই অ্যাকাউন্ট থেকে নির্ধারিত হয়। তাই লেখার আগে গুগল দিয়ে প্রবেশ করুন।</p>
      <a class="read-button" href="/auth/sign-in/"><span>গুগল দিয়ে প্রবেশ করুন</span><span aria-hidden="true">→</span></a>
    </section>
    <div class="writer-state" data-writer-state hidden></div>
    <form class="article-editor" data-article-form data-signed-in-only hidden>
      <div class="editor-note"><span aria-hidden="true">✦</span><p>প্রকাশিত প্রতিবেদনের জন্য নির্ধারিত হার অনুযায়ী পারিশ্রমিক জমা হবে। আয় তুলতে প্রোফাইল ১০০% সম্পূর্ণ হতে হবে।</p></div>
      <label class="field-label">প্রতিবেদনের শিরোনাম<input name="title" maxlength="180" placeholder="আপনার প্রতিবেদনের শিরোনাম" required /></label>
      <div class="editor-two-col"><label class="field-label">বিভাগ<select name="category_slug" required>{categories.filter((category) => category.slug !== 'all').map((category) => <option value={category.slug}>{category.label}</option>)}</select></label><div class="field-label">প্রতিবেদনের ঠিকানা<span class="slug-preview" data-slug-preview>/news/…</span><small>শিরোনাম থেকে ইংরেজি ঠিকানা স্বয়ংক্রিয়ভাবে তৈরি হবে—কিছু লিখতে হবে না।</small></div></div>
      <label class="field-label">সংক্ষিপ্ত পরিচিতি<textarea name="excerpt" rows="3" maxlength="280" placeholder="প্রতিবেদনটি কী নিয়ে—২৮০ অক্ষরের মধ্যে" required></textarea></label>
      <label class="field-label">পূর্ণ প্রতিবেদন<textarea name="body" rows="12" minlength="100" maxlength="30000" placeholder="যাচাই করা তথ্য ও প্রাসঙ্গিক সূত্রসহ প্রতিবেদন লিখুন…" required></textarea><small>কমপক্ষে ১০০ অক্ষর। ব্যক্তিগত আক্রমণ, গুজব বা অনুমতিহীন ব্যক্তিগত তথ্য প্রকাশ করবেন না।</small></label>
      <section class="article-questionnaire" data-article-questionnaire hidden aria-live="polite">
        <div><span class="section-kicker">প্রতিবেদনের তথ্য</span><h2>ঘটনা ও কার্যক্রমের বিবরণ</h2><p>যা জানা নেই তা ফাঁকা রাখুন। ভুক্তভোগী ও অভিযুক্তের পরিচিতি কেবল প্রশাসনিক পর্যালোচনার জন্য; জনসমক্ষে শুধু পরিচয়বিহীন সামগ্রিক পরিসংখ্যান দেখানো হবে।</p></div>
        <div class="questionnaire-fields" data-questionnaire-fields></div>
      </section>
      <div class="editor-media">
        <label class="field-label">ছবি (ঐচ্ছিক)<input type="file" name="gallery_images" multiple accept="image/jpeg,image/png,image/webp,image/gif,image/avif" data-gallery-input /><small>একসাথে একাধিক ছবি যুক্ত করুন—প্রথম ছবিটিই প্রচ্ছদ হবে। সর্বোচ্চ ১০টি, প্রতিটি সর্বোচ্চ ২০ MB (JPEG, PNG, WebP, GIF, AVIF)। HEIC/HEIF সমর্থিত নয়। ছবি যুক্ত হলে নিচে গ্যালারিতে দেখাবে; ক্রম বদলাতে বা সরাতে পারবেন।</small><span class="form-hint" data-upload-permission-note hidden>রিপোর্টার অনুমতি প্রয়োজন — ছবি আপলোড করতে রিপোর্টার, মডারেটর বা অ্যাডমিন ভূমিকা লাগবে।</span></label>
        <div class="gallery-strip" data-gallery-strip hidden></div>
      </div>
      <label class="field-check editor-anonymous"><input type="checkbox" name="is_anonymous"><span><strong>নাম প্রকাশে অনিচ্ছুক</strong><small>প্রকাশিত প্রতিবেদনে আপনার নাম বা প্রোফাইল লিংক কোথাও দেখানো হবে না। সম্পাদকীয় ডেস্ক জানবে কে লিখেছেন, এবং পারিশ্রমিক আগের মতোই আপনার অ্যাকাউন্টে জমা হবে।</small></span></label>
      <section class="editor-admin" data-admin-only hidden>
        <div><span class="section-kicker">ডেস্ক নিয়ন্ত্রণ</span><h2>লেখক ও প্রকাশের সময়</h2><p>কেবল প্রশাসক এই দুটি নির্ধারণ করতে পারেন। খালি রাখলে প্রতিবেদনটি আপনার নিজের নামে, এখনই প্রকাশিত হবে।</p></div>
        <div class="editor-two-col">
          <label class="field-label">লেখক<select name="author_id" data-admin-author-select><option value="">নিজেই (আমি)</option></select><small>নির্বাচিত রিপোর্টারের নামে প্রতিবেদনটি প্রকাশিত হবে এবং পারিশ্রমিক তাঁর হিসাবেই জমা হবে।</small></label>
          <label class="field-label">প্রকাশের সময়<input type="datetime-local" name="published_at" data-admin-published-at /><small>ভবিষ্যতের সময় দেওয়া যাবে না। খালি রাখলে এখনকার সময় ব্যবহৃত হবে।</small></label>
        </div>
      </section>
      <p class="form-error" role="alert" data-article-error hidden></p>
      <div class="editor-submit-row"><button class="read-button" type="submit"><span>প্রতিবেদন পাঠান</span><span aria-hidden="true">→</span></button><span data-editor-status>জুনিয়র রিপোর্টারের প্রতিবেদন অনুমোদনের অপেক্ষায় থাকবে।</span></div>
    </form>
    <section class="reporter-application" data-application-section data-signed-in-only hidden><div><span class="section-kicker">এখনো রিপোর্টার নন?</span><h2>রিপোর্টার হিসেবে আবেদন করুন</h2><p>সম্পাদকীয় দল আপনার আবেদন পর্যালোচনা করে উপযুক্ত রিপোর্টার স্তর নির্ধারণ করবে। স্তর অনুমোদনের পর পারিশ্রমিক কার্যকর হবে।</p></div><form data-application-form><label class="field-label">লেখার অভিজ্ঞতা ও আগ্রহ<textarea name="motivation" rows="4" maxlength="1500" placeholder="আপনি কী ধরনের প্রতিবেদন করতে চান? আগের কাজ থাকলে সংক্ষেপে লিখুন।" required></textarea></label><p class="form-error" role="alert" data-application-error hidden></p><button class="outline-button" type="submit">আবেদন পাঠান <span aria-hidden="true">→</span></button></form></section>
  </section>
</BaseLayout>
